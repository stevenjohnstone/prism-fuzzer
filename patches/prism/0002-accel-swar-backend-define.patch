From 21f29f23b45355246fa1beae37899781cc4289e7 Mon Sep 17 00:00:00 2001
From: Steven Johnstone <steven.james.johnstone@gmail.com>
Date: Thu, 19 Nov 2026 00:32:44 +0000
Subject: [PATCH] Differential fuzzing of scan_identifier_ascii

Check for divergence between different accelerated implementations
which underpin the prism strpbrk implementation.

diff --git a/include/prism/compiler/accel.h b/include/prism/compiler/accel.h
index 393cf63f5..b24849dd2 100644
--- a/include/prism/compiler/accel.h
+++ b/include/prism/compiler/accel.h
@@ -15,7 +15,11 @@
  * each strategy relies only on instructions that the architecture baseline
  * guarantees: NEON is mandatory on AArch64 and SSE2 is mandatory on x86-64.
  */
-#if (defined(__aarch64__) && defined(__ARM_NEON)) || (defined(_MSC_VER) && defined(_M_ARM64))
+#if defined(PRISM_ACCEL_SWAR)
+#   if defined(PRISM_LITTLE_ENDIAN_COMPTIME)
+#       define PRISM_HAS_SWAR
+#   endif
+#elif (defined(__aarch64__) && defined(__ARM_NEON)) || (defined(_MSC_VER) && defined(_M_ARM64))
 #   define PRISM_HAS_NEON
 #elif (defined(__x86_64__) && defined(__SSE2__)) || (defined(_MSC_VER) && defined(_M_X64))
 #   define PRISM_HAS_SSE2
