diff --git a/include/prism/internal/ijon.h b/include/prism/internal/ijon.h
new file mode 100644
index 0000000..d23b727
--- /dev/null
+++ b/include/prism/internal/ijon.h
@@ -0,0 +1,91 @@
+#ifndef PRISM_INTERNAL_IJON_H
+#define PRISM_INTERNAL_IJON_H
+
+/* AFL++ force-includes afl/types.h under AFL_LLVM_IJON=1, which defines MIN/MAX
+ * before src/prism.c defines its own MIN/MAX macros. */
+#ifdef _USE_IJON
+#undef MIN
+#undef MAX
+#endif
+
+#if defined(PRISM_FUZZ_IJON) && !defined(PRISM_NO_SOURCE_IJON)
+#define PRISM_FUZZ_IJON_ENABLED 1
+#include "prism/compiler/inline.h"
+
+#include <stdint.h>
+
+#ifndef _USE_IJON
+extern void ijon_set(uint32_t addr, uint32_t val);
+extern void ijon_max(uint32_t addr, uint64_t val);
+#endif
+
+#ifndef FUZZ_IJON_SIDE_SALT
+#define FUZZ_IJON_SIDE_SALT 0u
+#endif
+
+#define PM_IJON_MAX_CAP 0x3fffffffffffffffULL
+
+static PRISM_INLINE uint32_t
+pm_ijon_mix32(uint32_t h) {
+    h ^= h >> 16;
+    h *= 0x85ebca6bu;
+    h ^= h >> 13;
+    h *= 0xc2b2ae35u;
+    h ^= h >> 16;
+    return h;
+}
+
+static PRISM_INLINE uint32_t
+pm_ijon_loc(uint32_t tag) {
+    uint32_t h = pm_ijon_mix32(tag ^ (uint32_t) FUZZ_IJON_SIDE_SALT ^ 0x9e3779b9u);
+    return h == 0u ? 1u : h;
+}
+
+static PRISM_INLINE uint64_t
+pm_ijon_clamp(uint64_t val) {
+    return val < PM_IJON_MAX_CAP ? val : PM_IJON_MAX_CAP;
+}
+
+#define PM_IJON_SET(tag, val) \
+    do { \
+        uint32_t pm_ijon_addr_ = pm_ijon_loc((uint32_t) (tag)); \
+        ijon_set(pm_ijon_addr_, pm_ijon_mix32(pm_ijon_addr_ ^ (uint32_t) (val))); \
+    } while (0)
+
+#define PM_IJON_MAX(tag, val) \
+    do { \
+        ijon_max(pm_ijon_loc((uint32_t) (tag)), pm_ijon_clamp((uint64_t) (val))); \
+    } while (0)
+
+#define PM_IJON_MIN(tag, dist) \
+    do { \
+        ijon_max(pm_ijon_loc((uint32_t) (tag)), PM_IJON_MAX_CAP - pm_ijon_clamp((uint64_t) (dist))); \
+    } while (0)
+
+#define PM_IJON_SET_IF(cond, tag, val) \
+    do { \
+        if (cond) PM_IJON_SET(tag, val); \
+    } while (0)
+
+#define PM_IJON_MAX_IF(cond, tag, val) \
+    do { \
+        if (cond) PM_IJON_MAX(tag, val); \
+    } while (0)
+
+#define PM_IJON_MIN_IF(cond, tag, dist) \
+    do { \
+        if (cond) PM_IJON_MIN(tag, dist); \
+    } while (0)
+
+#else
+
+#define PM_IJON_SET(tag, val) ((void) 0)
+#define PM_IJON_MAX(tag, val) ((void) 0)
+#define PM_IJON_MIN(tag, dist) ((void) 0)
+#define PM_IJON_SET_IF(cond, tag, val) ((void) 0)
+#define PM_IJON_MAX_IF(cond, tag, val) ((void) 0)
+#define PM_IJON_MIN_IF(cond, tag, dist) ((void) 0)
+
+#endif
+
+#endif
