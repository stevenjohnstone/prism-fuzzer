index 8bcdea96f660d8c419336163773515724372b54e..08d9d31e414a7d0d127838810459535a553fe680 100644
--- a/src/double.c
+++ b/src/double.c
@@ -187,6 +187,8 @@ pm_binary64_round(uint64_t mantissa, int64_t exponent, bool inexact) {
      * subnormal if the value is that small. */
     int64_t shift = (int64_t) pm_bsrll(mantissa) + 1 - 53;
     if (shift < -1074 - exponent) shift = -1074 - exponent;
+    PM_IJON_MIN(0x501u, shift <= 0 ? 0ULL : (uint64_t) shift);
+    PM_IJON_MIN(0x503u, exponent + shift >= 971 ? 0ULL : (uint64_t) (971 - (exponent + shift)));
 
     uint64_t bits;
     if (shift <= 0) {
@@ -197,6 +199,7 @@ pm_binary64_round(uint64_t mantissa, int64_t exponent, bool inexact) {
     } else {
         uint64_t half = (uint64_t) 1 << (shift - 1);
         uint64_t rest = mantissa & (half - 1 + half);
+        PM_IJON_MIN(0x502u, rest ^ half);
         bits = shift == 64 ? 0 : mantissa >> shift;
         if (rest > half || (rest == half && (inexact || (bits & 1)))) bits++;
     }
